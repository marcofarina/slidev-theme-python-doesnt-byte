{
  "name": "slidev-theme-python-doesnt-byte",
  "version": "0.0.0",
  "description": "Tema Slidev per le slide delle lezioni di Python Doesn't Byte",
  "author": "Marco Farina",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marcofarina/slidev-theme-python-doesnt-byte.git"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "pdb-copy-pyodide": "bin/copy-pyodide.mjs"
  },
  "scripts": {
    "predev": "node bin/copy-pyodide.mjs",
    "dev": "slidev example.md --open",
    "prebuild": "node bin/copy-pyodide.mjs",
    "build": "slidev build example.md",
    "preexport": "node bin/copy-pyodide.mjs",
    "export": "slidev export example.md",
    "prescreenshot": "node bin/copy-pyodide.mjs",
    "screenshot": "slidev export example.md --format png",
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "presnap": "node bin/copy-pyodide.mjs",
    "snap": "node scripts/snap.mjs",
    "test:runner": "node test/runner-offline.mjs"
  },
  "dependencies": {
    "@slidev/types": "^53.0.0",
    "markdown-it-container": "^4.0.0",
    "pyodide": "^314.0.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "markdown-exit": "^1.3.0",
    "playwright-chromium": "^1.64.1"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "colorSchema": "light",
      "transition": "none",
      "aspectRatio": "16/9",
      "canvasWidth": 980,
      "highlighter": "shiki",
      "lineNumbers": false,
      "mdc": false,
      "fonts": {
        "sans": "Crimson Pro",
        "serif": "Crimson Pro",
        "mono": "Monaspace Neon",
        "local": [
          "Crimson Pro",
          "Monaspace Neon",
          "Monaspace Radon",
          "Monaspace Argon"
        ],
        "provider": "none"
      }
    }
  }
}
