{
  "name": "slidev-theme-python-doesnt-byte",
  "version": "0.0.0",
  "description": "Tema Slidev per le slide delle lezioni di Python Doesn't Byte",
  "author": "Marco Farina",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marcofarina/slidev-theme-python-doesnt-byte.git"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "pdb-copy-pyodide": "bin/copy-pyodide.mjs",
    "pdb-check": "bin/check.mjs",
    "pdb-verify": "bin/verify.mjs",
    "pdb-contact-sheet": "bin/contact-sheet.mjs",
    "pdb-copy-sqljs": "bin/copy-sqljs.mjs"
  },
  "scripts": {
    "predev": "node bin/copy-pyodide.mjs && node bin/copy-sqljs.mjs",
    "dev": "slidev example.md --open",
    "prebuild": "node bin/copy-pyodide.mjs && node bin/copy-sqljs.mjs",
    "build": "slidev build example.md",
    "preexport": "node bin/copy-pyodide.mjs && node bin/copy-sqljs.mjs",
    "export": "slidev export example.md",
    "prescreenshot": "node bin/copy-pyodide.mjs && node bin/copy-sqljs.mjs",
    "screenshot": "slidev export example.md --format png",
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "presnap": "node bin/copy-pyodide.mjs && node bin/copy-sqljs.mjs",
    "snap": "node scripts/snap.mjs",
    "test:runner": "node test/runner-offline.mjs",
    "test:sql": "node test/sql-offline.mjs",
    "pretest:visual": "node bin/copy-pyodide.mjs && node bin/copy-sqljs.mjs",
    "test:visual": "node test/visual/run.mjs",
    "pretest:visual:update": "node bin/copy-pyodide.mjs && node bin/copy-sqljs.mjs",
    "test:visual:update": "node test/visual/run.mjs --update",
    "check": "node bin/check.mjs example.md",
    "verify": "node bin/verify.mjs example.md",
    "sheet": "node bin/contact-sheet.mjs example.md",
    "test": "node --test test/*.test.mjs && npm run check && npm run verify && npm run test:runner && npm run test:sql && npm run test:visual"
  },
  "dependencies": {
    "@slidev/parser": "^53.0.0",
    "@slidev/types": "^53.0.0",
    "markdown-it-container": "^4.0.0",
    "pele": "^1.12.0",
    "pyodide": "^314.0.7",
    "qrcode": "^1.5.4",
    "sql.js": "^1.15.2"
  },
  "peerDependencies": {
    "playwright-chromium": "^1.64.1"
  },
  "peerDependenciesMeta": {
    "playwright-chromium": {
      "optional": true
    }
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "markdown-exit": "^1.3.0",
    "pixelmatch": "^8.0.0",
    "playwright-chromium": "^1.64.1",
    "pngjs": "^7.0.0"
  },
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "colorSchema": "light",
      "transition": "none",
      "aspectRatio": "16/9",
      "canvasWidth": 980,
      "highlighter": "shiki",
      "lineNumbers": false,
      "mdc": false,
      "fonts": {
        "sans": "Crimson Pro",
        "serif": "Crimson Pro",
        "mono": "Monaspace Neon",
        "local": [
          "Crimson Pro",
          "Monaspace Neon",
          "Monaspace Radon",
          "Monaspace Argon"
        ],
        "provider": "none"
      }
    }
  }
}
